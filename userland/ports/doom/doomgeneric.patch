diff --git a/doomgeneric/doomgeneric_impl.cpp b/doomgeneric/doomgeneric_impl.cpp
new file mode 100644
index 0000000..06b39fb
--- /dev/null
+++ b/doomgeneric/doomgeneric_impl.cpp
@@ -0,0 +1,160 @@
+#include <stdio.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/time.h>
+#include <sys/ioctl.h>
+#include <string.h>
+#include <errno.h>
+
+#include "doomgeneric.h"
+#include "doomkeys.h"
+
+extern "C" {
+
+struct KeyEvent {
+    char ascii;
+    uint8_t scancode;
+    uint8_t modifiers;
+};
+
+struct KeyQueue {
+    static constexpr size_t QUEUE_SIZE = 16;
+
+    uint8_t head;
+    uint8_t tail;
+    KeyEvent queue[QUEUE_SIZE];
+
+    bool empty() const {
+        return head == tail;
+    }
+
+    void insert(const KeyEvent& event) {
+        queue[head] = event;
+        head = (head + 1) % QUEUE_SIZE;
+    }
+
+    KeyEvent pop() {
+        KeyEvent event = queue[tail];
+        tail = (tail + 1) % QUEUE_SIZE;
+
+        return event;
+    }
+};
+
+struct DoomState {
+    uint32_t* framebuffer;
+    int kb;
+
+    KeyQueue keys;
+
+    void update() {
+        KeyEvent event;
+        while (read(kb, &event, sizeof(event)) > 0) {
+            keys.insert(event);
+        }
+    }
+};
+
+static DoomState s_state = {};
+
+void DG_Init() {
+    int gpu = open("/dev/gpu/card0", O_RDONLY);
+    if (gpu < 0) {
+        perror("open '/dev/gpu/card0'");
+        exit(EXIT_FAILURE);
+    }
+    
+    struct gpu_connector conn;
+    if (ioctl(gpu, GPU_GET_CONNECTORS, &conn) < 0) {
+        perror("ioctl");
+        exit(EXIT_FAILURE);
+    }
+    
+    struct gpu_connector_map_fb map_fb;
+    map_fb.id = conn.id;
+
+    if (ioctl(gpu, GPU_CONNECTOR_MAP_FB, &map_fb) < 0) {
+        perror("ioctl");
+        exit(EXIT_FAILURE);
+    }
+    
+    s_state.framebuffer = reinterpret_cast<uint32_t*>(map_fb.framebuffer);
+    memset(s_state.framebuffer, 0x00, conn.height * conn.pitch);
+
+    s_state.kb = open("/dev/input/keyboard0", O_RDONLY | O_NONBLOCK);
+    if (s_state.kb < 0) {
+        perror("open '/dev/input/keyboard0'");
+        exit(EXIT_FAILURE);
+    }
+}
+
+void DG_DrawFrame() {
+    memcpy(s_state.framebuffer, DG_ScreenBuffer, DOOMGENERIC_RESX * DOOMGENERIC_RESY * 4);
+}
+
+void DG_SleepMs(uint32_t ms) {
+    usleep(ms * 1000);
+}
+
+uint32_t DG_GetTicksMs() {
+    static uint32_t ticks = 0;
+    return ticks++;
+}
+
+int DG_GetKey(int* pressed, unsigned char* key) {
+    if (s_state.keys.empty()) {
+        return 0;
+    }
+
+    KeyEvent event = s_state.keys.pop();
+    *pressed = !(event.scancode & 0x80);
+
+    switch (event.scancode & ~0x80) {
+        case 0x1C:
+            *key = KEY_ENTER;
+            break;
+        case 0x01:
+            *key = KEY_ESCAPE;
+            break;
+        case 0x4B:
+            *key = KEY_LEFTARROW;
+            break;
+        case 0x4D:
+            *key = KEY_RIGHTARROW;
+            break;
+        case 0x48:
+            *key = KEY_UPARROW;
+            break;
+        case 0x50:
+            *key = KEY_DOWNARROW;
+            break;
+        case 0x1D:
+            *key = KEY_FIRE;
+            break;
+        case 0x39:
+            *key = KEY_USE;
+            break;
+        case 0x2a:
+            *key = KEY_RSHIFT;
+            break;
+        default:
+            *key = event.ascii;
+            break;
+    }
+
+    return 1;
+}
+
+void DG_SetWindowTitle(const char*) {}
+
+int main(int argc, char** argv) {
+    doomgeneric_Create(argc, argv);
+
+    while (true) {
+        s_state.update();
+        doomgeneric_Tick();
+    }
+}
+
+}
